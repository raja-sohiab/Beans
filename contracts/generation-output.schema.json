{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beans Generation Output",
  "type": "object",
  "required": [
    "run_id",
    "lead_id",
    "subject",
    "greeting",
    "body",
    "signature",
    "evidence_ids"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lead_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "greeting": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "ps": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
