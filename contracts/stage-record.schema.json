{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beans Stage Record",
  "type": "object",
  "required": [
    "run_id",
    "lead_id",
    "stage",
    "status",
    "input_sha256",
    "output_sha256",
    "model",
    "invocation_id",
    "output"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lead_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "failed",
        "needs_review"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
